generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { PASSENGER DRIVER ADMIN }
enum DriverStatus { OFFLINE AVAILABLE BUSY SUSPENDED }
enum RideStatus { REQUESTED ACCEPTED ARRIVING STARTED COMPLETED CANCELLED }
enum KycStatus { PENDING APPROVED REJECTED }
model User { id String @id @default(cuid()); name String; phone String @unique; passwordHash String; role Role @default(PASSENGER); phoneVerified Boolean @default(false); pushToken String?; createdAt DateTime @default(now()); driverProfile DriverProfile?; passengerRides Ride[] @relation("PassengerRides"); driverRides Ride[] @relation("DriverRides"); otpCodes OtpCode[]; safetyReports SafetyReport[] @relation("Reporter") }
model OtpCode { id String @id @default(cuid()); userId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); codeHash String; expiresAt DateTime; used Boolean @default(false); createdAt DateTime @default(now()); @@index([userId,used]) }
model DriverProfile { id String @id @default(cuid()); userId String @unique; user User @relation(fields:[userId],references:[id],onDelete:Cascade); residenceZip String?; vehicleMake String?; vehicleModel String?; plateNumber String?; licenseNumber String?; kycStatus KycStatus @default(PENDING); licenseImageUrl String?; vehicleImageUrl String?; points Int @default(0); commissionDebt Int @default(0); status DriverStatus @default(OFFLINE); lat Float?; lng Float?; lastLocationAt DateTime?; updatedAt DateTime @updatedAt }
model Ride { id String @id @default(cuid()); passengerId String; driverId String?; passenger User @relation("PassengerRides",fields:[passengerId],references:[id]); driver User? @relation("DriverRides",fields:[driverId],references:[id]); pickupLat Float; pickupLng Float; destinationLat Float; destinationLng Float; pickupAddress String?; destinationAddress String?; fare Int; commission Int; status RideStatus @default(REQUESTED); requestedAt DateTime @default(now()); acceptedAt DateTime?; startedAt DateTime?; completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status,createdAt]); @@index([driverId,status]) }
model CommissionPayment { id String @id @default(cuid()); driverId String; amount Int; reference String?; status String @default("PENDING"); createdAt DateTime @default(now()) }
model SafetyReport { id String @id @default(cuid()); reporterId String; rideId String?; type String; note String?; createdAt DateTime @default(now()); reporter User @relation("Reporter",fields:[reporterId],references:[id]) }
model Notification { id String @id @default(cuid()); userId String; title String; body String; read Boolean @default(false); createdAt DateTime @default(now()); @@index([userId,read]) }
